# Docker Compose Environment Variables
# This file is used by docker-compose.yml for container configuration
# Laravel application uses backend/.env for its own configuration

# ローカル開発で起動する Compose プロファイル。
# MailHog は profiles: ["dev"] なので、これを dev にしておくと
# `docker compose up -d` で従来どおり MailHog も起動する。
# ★本番(.env)ではこの行を設定しないこと（MailHog を起動させない。本番メールは resend）。
COMPOSE_PROFILES=dev

# HTTP Port for Nginx Web Server
HTTP_PORT=8080

# Database Configuration
DB_PORT=3306
DB_DATABASE=motohub
DB_USERNAME=sail
DB_PASSWORD=password

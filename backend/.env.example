APP_NAME=MotoHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

HTTP_PORT=8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=motohub
DB_USERNAME=sail
DB_PASSWORD=password

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@motohub.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@motohub.jp
# --- バックアップ（spatie/laravel-backup → Cloudflare R2） ---
# R2_ENDPOINT が設定されていれば保存先が r2、無ければ local になる（BACKUP_DISK で明示上書き可）。
# 認証情報は Cloudflare の R2 API トークン（Object Read & Write・対象バケット限定）から発行する。
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_DEFAULT_REGION=auto

# --- 在庫画像（listings/...）の退避先 R2（バックアップ用 r2 とは別バケット/別資格情報） ---
# LISTING_IMAGE_DISK: 在庫画像の公開URL生成の切替口。既定 public（＝従来と完全に同一のURL）。
#   r2_images にすると listing_image_url() が R2_IMAGES_URL 基点のURLを返す。
# バケットは motohub-images、公開は Custom Domain https://img.motohub.jp（Active）。
# 資格情報は R2 API トークン（Object Read & Write・motohub-images 限定）から発行する。
LISTING_IMAGE_DISK=public
R2_IMAGES_ACCESS_KEY_ID=
R2_IMAGES_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=motohub-images
R2_IMAGES_ENDPOINT=https://9a62b0770113ef3c24104f90d0773964.r2.cloudflarestorage.com
R2_IMAGES_URL=https://img.motohub.jp
# バックアップzipの暗号化パスワード（.envを含むため必須）。強いものを生成しパスワードマネージャに保管。
BACKUP_ARCHIVE_PASSWORD=
# 失敗通知の宛先（未設定なら CONTACT_ADMIN_EMAIL を使用）
BACKUP_NOTIFICATION_EMAIL=

# 教習所ページ 合宿アフィリCTA（未設定なら枠を出さない）
SCHOOL_AFFILIATE_URL=
SCHOOL_AFFILIATE_PROVIDER=
SCHOOL_AFFILIATE_IMP_URL=
SCHOOL_AFFILIATE_LABEL=

# 免許ガイド記事 合宿アフィリバナー（url と banner_url が揃うまで枠を出さない）
LICENSE_AFFILIATE_URL=
LICENSE_AFFILIATE_BANNER_URL=
LICENSE_AFFILIATE_IMP_URL=
LICENSE_AFFILIATE_WIDTH=300
LICENSE_AFFILIATE_HEIGHT=250
LICENSE_AFFILIATE_PROVIDER=
LICENSE_AFFILIATE_ALT=

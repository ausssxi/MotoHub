<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- force=true: コンテナ等が実環境変数 DB_CONNECTION=mysql を渡しても必ず sqlite を使う。
             これが無いと php artisan test が dev MySQL に接続し RefreshDatabase が dev DB を migrate:fresh で破壊する。 -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- 外部APIクレデンシャルの空化（force=true）。
             .env.testing が無いため testing は backend/.env を読む。実キーが入っていると
             Http::fake の書き忘れでテストが本物の外部API（楽天/Yahoo/AI等）を叩いて事故る
             （MaintenanceBatteryTest が楽天を実呼び出ししていた実績）。
             各サービスはキー未設定時に通信せず空を返すガードを持つ（例: ProductSearchService）。
             ※OAuthの client_id/secret（redirect生成）・recaptcha secret（検証分岐）・mail（array駆動）は
               挙動を変えうるため据え置き。個別テストが必要な値は自前で config()->set して上書きする。 -->
        <env name="RAKUTEN_APP_ID" value="" force="true"/>
        <env name="RAKUTEN_ACCESS_KEY" value="" force="true"/>
        <env name="RAKUTEN_AFFILIATE_ID" value="" force="true"/>
        <env name="YAHOO_CLIENT_ID" value="" force="true"/>
        <env name="VALUECOMMERCE_SID" value="" force="true"/>
        <env name="VALUECOMMERCE_PID" value="" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="YOUTUBE_API_KEY" value="" force="true"/>
        <env name="GOOGLE_MAPS_API_KEY" value="" force="true"/>
        <env name="LINE_MESSAGING_CHANNEL_TOKEN" value="" force="true"/>
        <env name="TWITTER_CONSUMER_KEY" value="" force="true"/>
        <env name="TWITTER_CONSUMER_SECRET" value="" force="true"/>
        <env name="TWITTER_ACCESS_TOKEN" value="" force="true"/>
        <env name="TWITTER_ACCESS_TOKEN_SECRET" value="" force="true"/>
        <env name="SLACK_BOT_USER_OAUTH_TOKEN" value="" force="true"/>
        <env name="INDEXNOW_KEY" value="" force="true"/>
    </php>
</phpunit>
